eye_env/
__pycache__/
*.pt
input-videos/
roboflow_api_key.env
.pytest_cache/
.env

# ---------------------------------------------------------------------------
# EyeCU_external_data/ : third-party dataset bulk stays out; the records that
# make it reproducible go in. Same shape as the data/ block below -- `dir/*`
# rather than `dir/`, because git will not descend into a directory excluded by
# name and every negation under it would be silently dead.
#
# Out: images, videos, ZIPs, the 55 GB of GSR JSON, the CA bundle, and the
# SoccerTrack public repo checkout (it clones from upstream).
# In:  the master registry, per-source manifests, download logs, pointers.
# ---------------------------------------------------------------------------
EyeCU_external_data/*
!EyeCU_external_data/MASTER_EXTERNAL_SOURCE_REGISTRY.json
!EyeCU_external_data/consolidation_log.json

!EyeCU_external_data/roboflow_audit/
EyeCU_external_data/roboflow_audit/*
!EyeCU_external_data/roboflow_audit/manifests/
!EyeCU_external_data/roboflow_audit/reports/

!EyeCU_external_data/huggingface/
EyeCU_external_data/huggingface/*
!EyeCU_external_data/huggingface/manifests/
!EyeCU_external_data/huggingface/download_logs/
!EyeCU_external_data/huggingface/keremberke_football_object_detection/
EyeCU_external_data/huggingface/keremberke_football_object_detection/*
!EyeCU_external_data/huggingface/keremberke_football_object_detection/manifests/
!EyeCU_external_data/huggingface/soccernet_v3/
EyeCU_external_data/huggingface/soccernet_v3/*
!EyeCU_external_data/huggingface/soccernet_v3/manifests/

!EyeCU_external_data/soccertrack_v2/
EyeCU_external_data/soccertrack_v2/*
!EyeCU_external_data/soccertrack_v2/manifests/
!EyeCU_external_data/soccertrack_v2/reports/

!EyeCU_external_data/research_sources/
EyeCU_external_data/research_sources/*
!EyeCU_external_data/research_sources/manifests/
!EyeCU_external_data/research_sources/teamtrack/
!EyeCU_external_data/research_sources/sportslabkit/

# One-off diagnostic renders land in the repo root and pile up fast. Keepers
# belong in experiments/records/evidence/, which is tracked normally; this rule
# only stops scratch renders accumulating at root.
/*.png
/*.json
!/package.json

# ---------------------------------------------------------------------------
# data/ : ignored by default, with a narrow allow-list for the small records
# that are decisions rather than bulk.
#
# Note `data/*` and not `data/`. Git does not descend into a directory excluded
# by name, so with `data/` every `!data/...` negation below is silently dead --
# which is exactly what happened here: the manual identity annotation this repo
# calls "the value" was never actually tracked, and the files that looked
# tracked had been force-added by hand. `data/*` ignores each entry directly
# under data/ while still allowing a negation to re-include a subtree.
#
# Each block follows the same shape:
#     !dir/        re-include the directory so git will look inside
#     dir/*        ignore its contents again
#     !dir/keep    name exactly what is worth keeping
#
# Bulk stays out: decoded frames, annotation MP4s, QC renders, model weights,
# source video, caches, and reproducible smoke artifacts.
# ---------------------------------------------------------------------------
data/*

# Batch assignments and the frame manifest are decisions worth sharing.
!data/batches/
data/batches/*
!data/batches/*.json

# Temporal-val and derived-train frames stay local; the window plan, split and
# provenance define the benchmark.
!data/temporal_val/
data/temporal_val/*
!data/temporal_val/manifest.json
!data/temporal_val/ANNOTATION.md
!data/temporal_val/SPLIT
!data/derived_train/
data/derived_train/*
!data/derived_train/manifest.json
!data/derived_train/SPLIT

# Experiment C images and labels rebuild from tools/build_experiment_c_dataset.py;
# the yaml and reproducibility record are what make the rebuild verifiable.
!data/dataset_C/
data/dataset_C/*
!data/dataset_C/football_C.yaml
!data/dataset_C/reproducibility.json

# Frozen tracking inputs are scientific benchmark inputs, not disposable
# diagnostics: the exact serialised detections are versioned, not just hashed.
!data/tracking_val_v1/
data/tracking_val_v1/*
!data/tracking_val_v1/manifest.json
!data/tracking_val_v1/detections/
data/tracking_val_v1/detections/*
!data/tracking_val_v1/detections/*.jsonl
!data/tracking_val_v1/candidates/
data/tracking_val_v1/candidates/*
!data/tracking_val_v1/candidates/*.jsonl

# Identity GT. Frames rebuild from tools/build_tracking_gt_package.py and are
# verified by decoded_frames_sha256; the annotation is hand-drawn and cannot be
# rebuilt from anything, so it is tracked without needing `git add -f`.
!data/tracking_val_gt/
data/tracking_val_gt/*
!data/tracking_val_gt/manifest.json

# detector preannotations: model output, but frozen and hashed in the manifest
!data/tracking_val_gt/preannotations/
data/tracking_val_gt/preannotations/*
!data/tracking_val_gt/preannotations/*.xml
!data/tracking_val_gt/preannotations/*.txt

# the raw human work, and the canonical form derived from it
!data/tracking_val_gt/cvat_exports/
data/tracking_val_gt/cvat_exports/*
!data/tracking_val_gt/cvat_exports/*.xml
!data/tracking_val_gt/cvat_exports/*.zip
!data/tracking_val_gt/cvat_exports/*.provenance.json
!data/tracking_val_gt/cvat_exports/README.txt
!data/tracking_val_gt/annotations/
data/tracking_val_gt/annotations/*
!data/tracking_val_gt/annotations/*.json
!data/tracking_val_gt/roles/
data/tracking_val_gt/roles/*
!data/tracking_val_gt/roles/*.json

# reference geometry with unconfirmed provenance -- not GT, but its status
# record is small and worth versioning
!data/tracking_val_gt/human_seed/
data/tracking_val_gt/human_seed/*
!data/tracking_val_gt/human_seed/*.json

# A rejected window: the annotation and the record of WHY it was rejected are
# both evidence, and a rejection that is not written down repeats itself.
!data/tracking_val_gt/rejected/
data/tracking_val_gt/rejected/*
!data/tracking_val_gt/rejected/*/
data/tracking_val_gt/rejected/*/*
!data/tracking_val_gt/rejected/*/*.json
!data/tracking_val_gt/rejected/*/*.xml

# QC decisions a human made. The contact sheets and clips beside them are
# regenerable renders and stay out; the decision records do not regenerate.
!data/tracking_val_gt/qc_identity/
data/tracking_val_gt/qc_identity/*
!data/tracking_val_gt/qc_identity/*/
data/tracking_val_gt/qc_identity/*/*
!data/tracking_val_gt/qc_identity/*/identity_gap_decisions.json
!data/tracking_val_gt/audit/
data/tracking_val_gt/audit/*
!data/tracking_val_gt/audit/*/
data/tracking_val_gt/audit/*/*
!data/tracking_val_gt/audit/*/*.json

# the MOT export TrackEval reads: derived, but small text, and versioning it
# makes an evaluation run reproducible from the repo alone
# The MOT layout nests four deep (mot/<split>/<seq>/gt/gt.txt), so this block
# matches by depth-independent glob rather than counting levels.
# Vendored TrackEval: read for the protocol freeze, and the file hashes are
# recorded in experiments/tracking_v2/trackeval_protocol.json. Rebuildable from
# the pinned wheel, so the bytes stay out of the repo.
# Anchored to the repo root: unanchored it also swallowed models/third_party/,
# hiding that directory's tracked provenance README.
/third_party/

!data/tracking_val_gt/mot/
data/tracking_val_gt/mot/**
# Vendored TrackEval: read for the protocol freeze, and the file hashes are
# recorded in experiments/tracking_v2/trackeval_protocol.json. Rebuildable from
# the pinned wheel, so the bytes stay out of the repo.
/third_party/

!data/tracking_val_gt/mot/**/
# Vendored TrackEval: read for the protocol freeze, and the file hashes are
# recorded in experiments/tracking_v2/trackeval_protocol.json. Rebuildable from
# the pinned wheel, so the bytes stay out of the repo.
/third_party/

!data/tracking_val_gt/mot/**/*.txt
# Vendored TrackEval: read for the protocol freeze, and the file hashes are
# recorded in experiments/tracking_v2/trackeval_protocol.json. Rebuildable from
# the pinned wheel, so the bytes stay out of the repo.
/third_party/

!data/tracking_val_gt/mot/**/*.ini

# External data audit: the extracted ZIP contents are ~330 MB of somebody
# else's images and rebuild exactly from the hashed archives, so they stay out.
# The reports, contact sheets and candidate index ARE the audit and are tracked.
experiments/external_data_audit/extracted/

# SoccerTrack audit: 2.5 GB of extracted third-party annotation, rebuilt exactly
# from the hashed archives in EyeCU_external_data/. Reports and contact sheets
# are the audit and are tracked.
experiments/soccertrack_audit/extracted/

# Bake-off: the records, configs, metrics and verdict are the evidence and are
# tracked. Raw per-frame tracker outputs are large and regenerate exactly from
# the frozen detections, so they stay local.
experiments/tracking_v2/bakeoff/outputs/
experiments/tracking_v2/t2/outputs/
experiments/tracking_v2/t2/meta/
experiments/tracking_v2/bakeoff/meta/

# Keremberke review package: the ledger, queue and working copy regenerate
# deterministically from the immutable export plus the triage, and the ledger
# alone is 13 MB. decisions.json is the opposite -- it is irreplaceable human
# work and is tracked explicitly.
experiments/external_sources/keremberke_review/ledger.json
experiments/external_sources/keremberke_review/review_queue.json
experiments/external_sources/keremberke_review/working_copy/
!experiments/external_sources/keremberke_review/decisions.json

# The promoted repaired export regenerates byte-identically from decisions.json
# plus the immutable source -- verified by running --apply twice -- so the
# annotations themselves are bulk. The manifest is not: it is the provenance
# record naming the log hash, the source hashes and every authorised change, and
# it is what makes the export reproducible at all.
experiments/external_sources/keremberke_review/repaired_export/*
!experiments/external_sources/keremberke_review/repaired_export/EXPORT_MANIFEST.json
experiments/external_sources/keremberke_review/repaired_export.previous/

# Stage-A Colab upload staging. Temporary: everything in it is a copy of
# something already tracked or already reproducible. Delete after the run.
/EyeCU_StageA_inputs/

# Third-party detector weights: obtain separately, see the directory README.
models/third_party/**/*.pt
